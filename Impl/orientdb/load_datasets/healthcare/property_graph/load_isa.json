{
  "source": { "file": { "path":"__TBAPATH/../../../Datasets/healthcare/property_graph/Disease_network_edges.csv" } },
  "extractor": { "csv": {"separator":","} },
  "transformers": [
    { "merge": { "joinFieldName":"source_id", "lookup":"Disease.disease_id", "unresolvedLinkAction": "ERROR" } },
    { "vertex": { "class": "Disease"} },
    { "edge": {
        "class": "Is_a",
        "joinFieldName": "destination_id",
        "lookup": "Disease.disease_id",
        "unresolvedLinkAction": "ERROR"
      }
    }
  ],
  "loader": {
    "orientdb": {
       "dbURL": "plocal:/opt/orientdb/databases/Healthcare",
       "dbType": "graph",
       "classes": [
         {"name": "Disease", "extends": "V"},
         {"name": "Is_a", "extends": "E"}
       ], "indexes": []
    }
  }
}
