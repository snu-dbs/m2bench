{
  "source": { "file": { "path": "__TBAPATH/../../../Datasets/healthcare/property_graph/Disease_network_nodes.csv" } },
  "extractor": { "csv": {"separator": ","} },
  "transformers": [
    { "vertex": { "class": "Disease" } }
  ],
  "loader": {
    "orientdb": {
       "dbURL": "plocal:/opt/orientdb/databases/Healthcare",
       "dbType": "graph",
       "classes": [
         {"name": "Disease", "extends": "V"}
       ],
       "indexes": [
	  {"class":"Disease", "fields":["disease_id:long"], "type":"UNIQUE" }
       ]
    }
  }
}
