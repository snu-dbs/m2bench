{
  "source": { "file": { "path": "__TBAPATH/../../../Datasets/healthcare/table/Patient.csv" } },
  "extractor": { "csv": {"separator": ","} },
  "transformers": [
    { "vertex": { "class": "Patient" } }
  ],
  "loader": {
    "orientdb": {
       "dbURL": "plocal:/opt/orientdb/databases/Healthcare",
       "dbType": "graph",
       "classes": [
         {"name": "Patient"}
       ], "indexes": [
         {"class":"Patient", "fields":["patient_id:integer"], "type":"UNIQUE" }
       ]
    }
  }
}
