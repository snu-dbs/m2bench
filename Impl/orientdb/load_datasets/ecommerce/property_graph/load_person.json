{
  "source": { "file": { "path": "__TBAPATH/../../../Datasets/ecommerce/property_graph/person_node.csv" } },
  "extractor": { "csv": {"separator": "|"} },
  "transformers": [
    { "vertex": { "class": "Person" } }
  ],
  "loader": {
    "orientdb": {
       "dbURL": "plocal:/opt/orientdb/databases/Ecommerce",
       "dbType": "graph",
       "classes": [
         {"name": "Person", "extends": "V"}
       ],
       "indexes": [
	  {"class":"Person", "fields":["person_id:integer"], "type":"UNIQUE" }
       ]
    }
  }
}
