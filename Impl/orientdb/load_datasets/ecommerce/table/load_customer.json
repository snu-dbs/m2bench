{
  "source": { "file": { "path": "__TBAPATH/../../../Datasets/ecommerce/table/Customer.csv" } },
  "extractor": { "csv": {"separator": "|"} },
  "transformers": [
    { "vertex": { "class": "Customer" } }
  ],
  "loader": {
    "orientdb": {
       "dbURL": "plocal:/opt/orientdb/databases/Ecommerce",
